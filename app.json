{
  "expo": {
    "name": "Xe",
    "slug": "xe",
    "version": "0.0.1",
    "scheme": "com.pm.xe",
    "platforms": ["ios", "android"],
    "plugins": [
      "expo-dev-client",
      "expo-router",
      "expo-font",
      [
        "expo-asset",
        {
          "assets": ["./src/assets/images"]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f5f5f5",
          "image": "./src/assets/appIcons/adaptive-icon.png",
          "imageWidth": 150
        }
      ],
      ["expo-sqlite", { "useSQLCipher": true }],
      "expo-secure-store",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "orientation": "portrait",
    "icon": "./src/assets/appIcons/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./src/assets/appIcons/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pm.xe",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Xe Export Package",
            "CFBundleTypeRole": "Editor",
            "LSItemContentTypes": ["com.pm.xe.package"]
          }
        ],
        "UTExportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.pm.xe.package",
            "UTTypeDescription": "Xe Export Package",
            "UTTypeConformsTo": ["public.data"],
            "UTTypeTagSpecification": {
              "public.filename-extension": ["xe"],
              "public.mime-type": "application/x-xe-package"
            }
          }
        ]
      },
      "buildNumber": "1",
      "appleTeamId": "C5TXZNQR66"
    },
    "android": {
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/appIcons/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.pm.xe",
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "mimeType": "application/x-xe-package"
            },
            {
              "mimeType": "application/octet-stream",
              "pathPattern": ".*\\.xe"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "extra": {
      "router": {
        "origin": false
      }
    },
    "owner": "omarf045"
  }
}
