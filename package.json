    "@tanstack/query-sync-storage-persister": "5.90.7",
    "@tanstack/react-query": "5.90.5",
    "@tanstack/react-query-persist-client": "5.90.7",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "expo": "^55.0.0",
    "expo-asset": "~55.0.8",
    "expo-constants": "~55.0.7",
    "expo-dev-client": "~55.0.11",
