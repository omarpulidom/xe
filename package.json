    "expo-status-bar": "~55.0.4",
    "expo-system-ui": "~55.0.9",
    "expo-updates": "~55.0.12",
    "expo-video": "~55.0.10",
    "ky": "1.12.0",
    "nativewind": "latest",
    "phosphor-react-native": "^3.0.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
